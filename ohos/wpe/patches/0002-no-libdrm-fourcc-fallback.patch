Сборка без libdrm: запасные определения кодов форматов буферов

AcceleratedBackingStore.cpp берёт DRM_FORMAT_XRGB8888 из заголовка libdrm,
который подключается только при USE(LIBDRM) или на Android. При сборке без
libdrm (мы выводим через поверхность системы, а не через DRM напрямую) файл
не собирается.

Сами коды форматов к libdrm отношения не имеют: это четырёхбуквенные
обозначения из общего соглашения о расположении точек в буфере, одинаковые
везде. Поэтому достаточно задать их, если заголовка нет.

--- a/Source/WebKit/UIProcess/wpe/AcceleratedBackingStore.cpp
+++ b/Source/WebKit/UIProcess/wpe/AcceleratedBackingStore.cpp
@@ -41,6 +41,16 @@
 #elif USE(LIBDRM)
 #include <drm_fourcc.h>
 #endif
+
+// Коды форматов — часть общего соглашения о буферах, а не принадлежность
+// libdrm. Задаём их, если заголовка нет.
+#ifndef DRM_FORMAT_XRGB8888
+#define DRM_FORMAT_XRGB8888 0x34325258 /* 'XR24' */
+#endif
+#ifndef DRM_FORMAT_ARGB8888
+#define DRM_FORMAT_ARGB8888 0x34325241 /* 'AR24' */
+#endif

 WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_BEGIN
 #include <skia/core/SkColorSpace.h>
