
Слой звука через ALSA: нет подпрограмм выбора устройства смесителя.

alsa_snd_render.c и alsa_snd_capture.c вызывают RenderGetSceneDev и
CaptureGetSceneDev. Обе объявлены в заголовках (alsa_snd_render.h,
alsa_snd_capture.h), обе вызываются при создании потока — и ни одна нигде
не определена. Сборка разваливается на связывании:

    ld.lld: error: undefined symbol: CaptureGetSceneDev
    >>> referenced by alsa_snd_capture.c:448

Почему это дожило до выпуска: слой через ALSA собирают редко. Переключатель
drivers_peripheral_audio_feature_alsa_lib по умолчанию выключен, и ни один
из продуктов в дереве его не включает — все идут через драйвер в ядре
(adm_adapter). Нам же нужен именно он: ядро у нас обычное, своего драйвера
OpenHarmony в нём нет, а звуковая карта видна через ALSA.

Что возвращать. Значение — номер устройства смесителя для сцены (разговор,
музыка, звонок), и -1 означает «без особого устройства». Вызывающий код
сам приводит к нему всё, что не укладывается в пределы:

    dev = RenderGetSceneDev(scene);
    if (dev > MIXER_CTL_MAX_NUM || dev < -1) {
        dev = -1;
    }
    ret = SndSaveCardListInfo(SND_PCM_STREAM_RENDER, dev);

На обычной звуковой карте отдельных путей смесителя под сцены нет: всё
идёт одним выходом. Поэтому -1 — не заглушка, а верный ответ для такого
железа. Если когда-нибудь появится устройство с раздельными путями, здесь
и нужно будет описать их выбор.

Проверено: после этой правки слой собирается, audio_host заводит
переходник primary, и звук доходит до карты.

diff --git a/audio/supportlibs/alsa_adapter/src/alsa_snd_capture.c b/audio/supportlibs/alsa_adapter/src/alsa_snd_capture.c
index 82b046780..3ed7af692 100755
--- a/audio/supportlibs/alsa_adapter/src/alsa_snd_capture.c
+++ b/audio/supportlibs/alsa_adapter/src/alsa_snd_capture.c
@@ -932,3 +932,13 @@ static void RegisterCaptureImpl(struct AlsaCapture *captureIns)
 
     captureIns->SetParams = CaptureSetHwParamsImpl;
 }
+
+/*
+ * Номер устройства смесителя для сцены — для ввода.
+ * Пояснение см. в alsa_snd_render.c: то же самое, только для записи.
+ */
+int32_t CaptureGetSceneDev(enum AudioCategory scene)
+{
+    (void)scene;
+    return -1;
+}
diff --git a/audio/supportlibs/alsa_adapter/src/alsa_snd_render.c b/audio/supportlibs/alsa_adapter/src/alsa_snd_render.c
index 52956e97b..be698e6fc 100755
--- a/audio/supportlibs/alsa_adapter/src/alsa_snd_render.c
+++ b/audio/supportlibs/alsa_adapter/src/alsa_snd_render.c
@@ -967,3 +967,21 @@ static void RegisterRenderImpl(struct AlsaRender *renderIns)
     renderIns->UpdateRouter = RenderUpdateRouterImpl;
 }
 
+
+/*
+ * Номер устройства смесителя для сцены.
+ *
+ * В выпуске эта подпрограмма объявлена в заголовке и вызывается, но нигде
+ * не определена — слой через ALSA собирают редко, и недописка дожила до
+ * выпуска.
+ *
+ * На обычной звуковой карте отдельных путей смесителя под сцены нет:
+ * разговор, музыка и звонок идут одним и тем же выходом. Возвращаем -1 —
+ * «без особого устройства». Это ровно то значение, которое вызывающий код
+ * подставляет сам, когда полученное не укладывается в пределы.
+ */
+int32_t RenderGetSceneDev(enum AudioCategory scene)
+{
+    (void)scene;
+    return -1;
+}
